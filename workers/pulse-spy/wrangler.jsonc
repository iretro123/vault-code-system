{
  "name": "vault-spy-pulse",
  "main": "index.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
  // Secrets: DELIVERY_HASH, WORKER_TOKEN, SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY.
  // Request URLs carry delivery capabilities and must never be logged.
}
